{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "fe-design-system.vercel.app" }
      ],
      "destination": "https://design.foreveryone.berlin/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "fe-design-system.vercel.app" }
      ],
      "destination": "https://design.foreveryone.berlin/:path*",
      "permanent": true
    }
  ]
}
